<!DOCTYPE html>
<html>
<body>

<div id="gallery"></div>

<script>
  const files = [
    "1654D7B3-3B2F-414F-907F-708E65E00563.png",
    "8C653650-4AEF-4E6E-8AB0-D1391104A3A2.png",
    "9F60C9AC-101A-447E-BC04-03970F49FA54.png",
    "IMG_1658.png",
    "IMG_1659.png"
  ];

  const gallery = document.getElementById('gallery');
  
  files.forEach(file => {
    const img = document.createElement('img');
    img.src = file;
    img.style.display = 'block';
    img.style.marginBottom = '10px';
    gallery.appendChild(img);
  });
</script>

</body>
</html>